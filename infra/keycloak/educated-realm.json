{
  "realm": "educated",
  "enabled": true,
  "displayName": "Educated",
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en", "ar"],
  "defaultLocale": "fr",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "otpPolicyType": "totp",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@educated.local",
    "fromDisplayName": "Educated"
  },
  "clients": [
    {
      "clientId": "educated-api",
      "name": "Educated API (audience only)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "educated-web",
      "name": "Educated web portals",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4201/*",
        "http://localhost:4202/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:4201",
        "http://localhost:4202"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:4201/*##http://localhost:4202/*"
      },
      "protocolMappers": [
        {
          "name": "educated-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "educated-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
